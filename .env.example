# Copy this file to .env (it is ignored by Git) and set the passwords and the key.
# Docker Compose reads .env automatically. Variables set in the shell win over .env.
DB_NAME=user_service_db
DB_USERNAME=user_service
DB_PASSWORD=change-me
CACHE_USERS_TTL=10m

# The shared key of the internal endpoints (header X-Internal-Key). It must be the same value as
# INTERNAL_API_KEY of the Authentication Service and of the Gateway. Generate one with:
#   openssl rand -base64 32
INTERNAL_API_KEY=change-me-internal-key

# The key set of the Authentication Service. While the Authentication Service runs on the host
# (port 8081), the container reaches it as host.docker.internal. In the Compose file of the whole
# system it is the service name of the Authentication Service instead.
AUTH_JWKS_URI=http://host.docker.internal:8081/.well-known/jwks.json
# The expected issuer of the tokens: the same value as JWT_ISSUER of the Authentication Service.
JWT_ISSUER=authentication-service
